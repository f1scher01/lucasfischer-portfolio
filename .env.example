# Resend — form de contato (server-only)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=voce@dominio.com

# Upstash Redis — rate limit persistente (opcional; sem eles usa in-memory)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Cloudflare Turnstile — captcha invisível (opcional; sem eles pula a etapa)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxx
